# Production Environment Template for Communication Platform Backend

APP_NAME="Communication Platform"
APP_ENV=production
APP_KEY=base64:GENERATE_PRODUCTION_KEY_HERE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database Configuration (MySQL / PostgreSQL in Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=communication_platform_prod
DB_USERNAME=comm_prod_user
DB_PASSWORD=SECURE_PRODUCTION_DB_PASSWORD
# Optional MySQL CA certificate for TLS/SSL database connections
MYSQL_ATTR_SSL_CA=certs/ca.pem

# Session & Security Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true

# Broadcasting & WebSocket Configuration
# Choose 'reverb' for Laravel Reverb or 'pusher' for external Pusher/Soketi
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100001
REVERB_APP_KEY=SECURE_REVERB_APP_KEY
REVERB_APP_SECRET=SECURE_REVERB_APP_SECRET
REVERB_HOST="ws.yourdomain.com"
REVERB_PORT=443
REVERB_SCHEME="https"

PUSHER_APP_ID="${REVERB_APP_ID}"
PUSHER_APP_KEY="${REVERB_APP_KEY}"
PUSHER_APP_SECRET="${REVERB_APP_SECRET}"
PUSHER_HOST="${REVERB_HOST}"
PUSHER_PORT="${REVERB_PORT}"
PUSHER_SCHEME="${REVERB_SCHEME}"
PUSHER_APP_CLUSTER=mt1

# Storage & Filesystem Configuration
FILESYSTEM_DISK=public
# FILESYSTEM_DISK=s3

# AWS S3 Configuration (Optional for cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Queue & Cache Configuration
QUEUE_CONNECTION=database
CACHE_STORE=database

# CORS Allowed Origins (Comma separated domains)
ALLOWED_ORIGINS="https://app.yourdomain.com,https://api.yourdomain.com"
